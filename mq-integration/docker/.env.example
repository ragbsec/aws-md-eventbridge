# Copy to .env (cloud-init writes it on the EC2 host). Never commit .env.
MQ_ADMIN_PASSWORD=CHANGE_ME
MQ_APP_PASSWORD=CHANGE_ME
# Pinned default (MQ Advanced for Developers 10.0.0.5-r2); override only with another tested tag
#MQ_IMAGE=icr.io/ibm-messaging/mq:10.0.0.5-r2
# Interface for published ports; keep loopback unless a security group protects the host.
#MQ_BIND_ADDR=127.0.0.1
